# ──────────────────────────────────────────────────────────────
# Mandate Retry Sequencer — Frontend Environment Variables
#
# For running the frontend directly (npm run dev), NOT Docker Compose:
#   cp frontend/.env.example frontend/.env
#
# Vite only exposes variables prefixed VITE_ to client code, and inlines them
# at BUILD time — changing this after `npm run build` / `docker build` has no
# effect until you rebuild.
#
# NEVER commit the real frontend/.env — it is in .gitignore.
# ──────────────────────────────────────────────────────────────

# Base URL the frontend calls for the API.
# - Local dev (npm run dev) against a locally-running backend: point directly
#   at it, e.g. http://localhost:8000/api/v1
# - Docker Compose: leave this as a relative path (/api/v1) — Nginx proxies
#   it to the backend container internally (see frontend/nginx.conf), and
#   docker-compose.yml passes it in as a build arg, so this file isn't read
#   in that workflow.
VITE_API_URL=http://localhost:8000/api/v1
