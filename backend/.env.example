# ──────────────────────────────────────────────────────────────
# Mandate Retry Sequencer — Backend Environment Variables
#
# For running the backend directly (uvicorn on your host machine), NOT
# Docker Compose:
#   cp backend/.env.example backend/.env
#
# Settings are read from here because uvicorn is launched from the project
# root (see backend/app/config/settings.py: env_file="backend/.env").
#
# For Docker Compose, use the .env.example at the repo root instead — see
# README.md "Environment variables" for which file applies to which workflow.
#
# NEVER commit the real backend/.env — it is in .gitignore.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME="Mandate Retry Sequencer"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=true

# ── API ───────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mandate_retry_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── CORS ──────────────────────────────────────────────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── LLM / Groq ────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30.0
MAX_RETRIES=2
RETRY_BACKOFF=0.5

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT=15.0

# ── Scheduler ─────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_RETRY_INTERVAL_SECONDS=60
SCHEDULER_SETTLEMENT_INTERVAL_SECONDS=60

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
