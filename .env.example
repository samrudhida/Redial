# ──────────────────────────────────────────────────────────────
# Mandate Retry Sequencer — Environment Variables Template
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit the actual .env file — it is in .gitignore.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME="Mandate Retry Sequencer"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=true

# ── API ───────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mandate_retry_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── CORS ──────────────────────────────────────────────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Groq LLM ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
LLM_TEMPERATURE=0.0

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Scheduler ─────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
