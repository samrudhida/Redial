# ──────────────────────────────────────────────────────────────
# Mandate Retry Sequencer — Environment Variables Template
#
# This file is for DOCKER COMPOSE. Docker Compose auto-loads a file named
# `.env` in this directory to fill in the ${VARIABLE} references in
# docker-compose.yml.
#
#   cp .env.example .env
#   docker compose up --build
#
# Running the backend/frontend directly instead (not via Docker)? Use
# backend/.env.example and frontend/.env.example instead — see README.md.
#
# NEVER commit the actual .env file — it is in .gitignore.
# ──────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
APP_NAME="Mandate Retry Sequencer"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production — dev-only
                              # endpoints (seed data, manual workflow runs)
                              # and the settlement-simulator job are only
                              # ever mounted/scheduled when this is "development"
DEBUG=false

# ── API ───────────────────────────────────────────────────────
API_PREFIX=/api/v1

# ── Database (used to build the backend's DATABASE_URL and to configure the
#    postgres container itself — see docker-compose.yml) ───────
POSTGRES_USER=mandate_user
POSTGRES_PASSWORD=change_me_before_deploying
POSTGRES_DB=mandate_retry_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── CORS ──────────────────────────────────────────────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── LLM / Groq ────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30.0
MAX_RETRIES=2
RETRY_BACKOFF=0.5

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT=15.0

# ── Scheduler ─────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_RETRY_INTERVAL_SECONDS=60
SCHEDULER_SETTLEMENT_INTERVAL_SECONDS=60

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Frontend build ────────────────────────────────────────────
# Leave as a relative path — Nginx proxies /api/ to the backend container
# internally (see frontend/nginx.conf). Only change this if you're serving
# the frontend from a different origin than the backend.
VITE_API_URL=/api/v1
